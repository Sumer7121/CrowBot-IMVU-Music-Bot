import json
import subprocess
import sys
import threading
import time

from http.server import (
    SimpleHTTPRequestHandler,
    ThreadingHTTPServer,
)

from pathlib import Path
from urllib.parse import quote, unquote


PROJECT_ROOT = Path(r"D:\IMVU-Music-Bot")

TEMP_DIR = (
    PROJECT_ROOT
    / "data"
    / "youtube_temp"
)

FFMPEG_DIR = (
    PROJECT_ROOT
    / "bin"
)

HTTP_HOST = "127.0.0.1"
HTTP_PORT = 8766


class ReusableHTTPServer(
    ThreadingHTTPServer
):
    allow_reuse_address = True


class YouTubeOwnedProvider:
    """
    YouTube provider using yt-dlp search.

    Search:
        ytsearchN:<query>
        --flat-playlist
        --dump-json

    This avoids downloading the enormous full-format
    metadata structure during the initial search.

    The existing RadioStreamServer on port 8765 is
    not modified.
    """

    def __init__(self):

        TEMP_DIR.mkdir(
            parents=True,
            exist_ok=True,
        )

        self.python_exe = str(
            Path(sys.executable)
        )

        self.http_server = None
        self.http_thread = None

        self.track_info = {}
        self.cleanup_started = set()

        self.lock = threading.RLock()

        self._purge_old_temp_files()

    # =========================================================
    # Compatibility
    # =========================================================

    def is_configured(self):
        return True

    # =========================================================
    # yt-dlp command
    # =========================================================

    def _ytdlp(self):

        return [
            self.python_exe,
            "-m",
            "yt_dlp",
        ]

    # =========================================================
    # FAST YT-DLP SEARCH
    # =========================================================

    def search_candidates(
        self,
        query,
        limit=5,
    ):
        query = str(
            query or ""
        ).strip()

        if not query:
            return []

        print()
        print(
            "========================================"
        )

        print(
            f"YTDLP SEARCH: {query}"
        )

        print(
            "========================================"
        )

        command = (
            self._ytdlp()
            + [
                f"ytsearch{limit}:{query}",

                "--flat-playlist",

                "--dump-json",

                "--skip-download",

                "--no-warnings",

                "--socket-timeout",
                "15",
            ]
        )

        try:

            process = subprocess.run(
                command,
                capture_output=True,
                text=True,
                encoding="utf-8",
                errors="replace",
                timeout=45,
            )

        except subprocess.TimeoutExpired as error:

            raise RuntimeError(
                "yt-dlp YouTube search timed out."
            ) from error

        if process.returncode != 0:

            raise RuntimeError(
                process.stderr.strip()
                or
                "yt-dlp YouTube search failed."
            )

        results = []

        for line in (
            process.stdout.splitlines()
        ):

            line = line.strip()

            if not line:
                continue

            try:

                data = json.loads(
                    line
                )

            except json.JSONDecodeError:
                continue

            video_id = str(
                data.get(
                    "id",
                    "",
                )
            ).strip()

            if not video_id:
                continue

            title = str(
                data.get(
                    "title",
                    "Unknown",
                )
            ).strip()

            channel = str(
                data.get("channel")
                or data.get("uploader")
                or "Unknown"
            ).strip()

            duration = data.get(
                "duration",
                0,
            )

            try:

                duration = int(
                    duration or 0
                )

            except (
                TypeError,
                ValueError,
            ):

                duration = 0

            youtube_url = (
                data.get(
                    "webpage_url"
                )
                or
                data.get(
                    "url"
                )
            )

            if (
                not youtube_url
                or
                not str(
                    youtube_url
                ).startswith(
                    "http"
                )
            ):

                youtube_url = (
                    "https://www.youtube.com/"
                    "watch?v="
                    f"{video_id}"
                )

            result = {
                "id": video_id,

                "title": title,

                "channel": channel,

                "duration": duration,

                "youtube_url": (
                    youtube_url
                ),
            }

            results.append(
                result
            )

        print()

        if not results:

            print(
                "YTDLP SEARCH: "
                "No results."
            )

            return []

        for index, result in enumerate(
            results,
            start=1,
        ):

            print(
                f"{index}. "
                f"{result['title']}"
            )

            print(
                "   Channel: "
                f"{result['channel']}"
            )

            print(
                "   ID: "
                f"{result['id']}"
            )

            print(
                "   URL: "
                f"{result['youtube_url']}"
            )

        print()

        return results

    # =========================================================
    # LICENSE METADATA
    # =========================================================

    def _get_license(
        self,
        youtube_url,
    ):

        command = (
            self._ytdlp()
            + [
                youtube_url,

                "--skip-download",

                "--no-playlist",

                "--print",
                "%(license)s",

                "--no-warnings",

                "--socket-timeout",
                "15",
            ]
        )

        try:

            process = subprocess.run(
                command,
                capture_output=True,
                text=True,
                encoding="utf-8",
                errors="replace",
                timeout=30,
            )

        except subprocess.TimeoutExpired:

            return ""

        if process.returncode != 0:
            return ""

        value = (
            process.stdout.strip()
        )

        if value.lower() in {
            "",
            "na",
            "none",
            "null",
        }:
            return ""

        return value

    def _is_reusable_license(
        self,
        license_name,
    ):

        value = str(
            license_name or ""
        ).lower()

        reusable_terms = (
            "creative commons",
            "cc-by",
            "cc by",
            "public domain",
        )

        return any(
            term in value
            for term in reusable_terms
        )

    # =========================================================
    # MAIN SEARCH
    # =========================================================

    def search(
        self,
        query,
        requested_by=None,
    ):

        candidates = (
            self.search_candidates(
                query,
                limit=5,
            )
        )

        if not candidates:
            return None

        print(
            "YTDLP: Checking candidate "
            "metadata..."
        )

        for index, candidate in enumerate(
            candidates,
            start=1,
        ):

            youtube_url = (
                candidate[
                    "youtube_url"
                ]
            )

            print()
            print(
                f"YTDLP: Candidate "
                f"{index}/"
                f"{len(candidates)}"
            )

            print(
                "YTDLP: "
                f"{candidate['title']}"
            )

            license_name = (
                self._get_license(
                    youtube_url
                )
            )

            print(
                "YTDLP: License: "
                f"{license_name or 'not specified'}"
            )

            if not (
                self._is_reusable_license(
                    license_name
                )
            ):

                print(
                    "YTDLP: Skipping "
                    "candidate."
                )

                continue

            print()
            print(
                "YTDLP: Selected result:"
            )

            print(
                "YTDLP: "
                f"{candidate['title']}"
            )

            return (
                self._prepare_track(
                    candidate,
                    query,
                    requested_by,
                )
            )

        print()
        print(
            "YTDLP: No explicitly reusable "
            "candidate was found."
        )

        return None

    # =========================================================
    # PREPARE TRACK
    # =========================================================

    def _prepare_track(
        self,
        candidate,
        query,
        requested_by,
    ):

        video_id = (
            candidate[
                "id"
            ]
        )

        title = (
            candidate[
                "title"
            ]
        )

        channel = (
            candidate[
                "channel"
            ]
        )

        duration = (
            candidate[
                "duration"
            ]
        )

        youtube_url = (
            candidate[
                "youtube_url"
            ]
        )

        mp3_path = (
            self._download_mp3(
                video_id,
                youtube_url,
            )
        )

        self._start_http_server()

        self._register_track(
            mp3_path,
            duration,
        )

        local_url = (
            self._build_local_url(
                mp3_path
            )
        )

        print()
        print(
            "========================================"
        )

        print(
            "YTDLP TRACK READY"
        )

        print(
            "========================================"
        )

        print(
            f"Title: {title}"
        )

        print(
            f"Channel: {channel}"
        )

        print(
            f"YouTube: {youtube_url}"
        )

        print(
            f"Local: {local_url}"
        )

        print(
            "========================================"
        )

        return {
            "id": video_id,

            "title": title,

            "track_title": title,

            "artist": channel,

            "duration": duration,

            "url": local_url,

            "youtube_url": (
                youtube_url
            ),

            "provider": "youtube",

            "source": (
                "youtube_reusable"
            ),

            "search_query": query,

            "requested_by": (
                requested_by
            ),

            "temporary_file": str(
                mp3_path
            ),
        }

    # =========================================================
    # DOWNLOAD / CONVERT
    # =========================================================

    def _download_mp3(
        self,
        video_id,
        youtube_url,
    ):

        final_mp3 = (
            TEMP_DIR
            / f"{video_id}.mp3"
        )

        output_template = str(
            TEMP_DIR
            / (
                f"{video_id}."
                "%(ext)s"
            )
        )

        if final_mp3.exists():

            try:

                final_mp3.unlink()

            except OSError:

                pass

        print()
        print(
            "YTDLP: Downloading audio..."
        )

        command = (
            self._ytdlp()
            + [
                youtube_url,

                "--extract-audio",

                "--audio-format",
                "mp3",

                "--audio-quality",
                "192K",

                "--ffmpeg-location",
                str(
                    FFMPEG_DIR
                ),

                "--output",
                output_template,

                "--no-playlist",
            ]
        )

        process = subprocess.run(
            command
        )

        if process.returncode != 0:

            raise RuntimeError(
                "yt-dlp download or "
                "conversion failed."
            )

        if not final_mp3.exists():

            candidates = list(
                TEMP_DIR.glob(
                    f"{video_id}*.mp3"
                )
            )

            if candidates:

                final_mp3 = (
                    candidates[0]
                )

        if not final_mp3.exists():

            raise RuntimeError(
                "MP3 was not created."
            )

        print()
        print(
            "YTDLP: MP3 ready:"
        )

        print(
            final_mp3
        )

        return final_mp3

    # =========================================================
    # TEMP HTTP SERVER :8766
    # =========================================================

    def _start_http_server(
        self,
    ):

        with self.lock:

            if self.http_server:
                return

            provider = self

            class Handler(
                SimpleHTTPRequestHandler
            ):

                def __init__(
                    self,
                    *args,
                    **kwargs,
                ):

                    super().__init__(
                        *args,
                        directory=str(
                            TEMP_DIR
                        ),
                        **kwargs,
                    )

                def log_message(
                    self,
                    format,
                    *args,
                ):

                    print(
                        "YOUTUBE HTTP:",
                        format % args,
                    )

                def do_GET(
                    self,
                ):

                    filename = (
                        self.path
                        .split(
                            "?",
                            1,
                        )[0]
                        .lstrip("/")
                    )

                    filename = unquote(
                        filename
                    )

                    provider._file_requested(
                        filename
                    )

                    try:

                        super().do_GET()

                    except (
                        ConnectionAbortedError,
                        ConnectionResetError,
                        BrokenPipeError,
                    ):

                        pass

            try:

                self.http_server = (
                    ReusableHTTPServer(
                        (
                            HTTP_HOST,
                            HTTP_PORT,
                        ),
                        Handler,
                    )
                )

            except OSError as error:

                raise RuntimeError(
                    "Could not start "
                    "temporary YouTube "
                    f"server on port "
                    f"{HTTP_PORT}. "
                    "Close any old test "
                    "server first. "
                    f"{error}"
                ) from error

            self.http_thread = (
                threading.Thread(
                    target=(
                        self.http_server
                        .serve_forever
                    ),
                    daemon=True,
                    name=(
                        "YouTubeTempHTTP"
                    ),
                )
            )

            self.http_thread.start()

            print()
            print(
                "YTDLP: Temporary HTTP "
                "server started:"
            )

            print(
                f"http://{HTTP_HOST}:"
                f"{HTTP_PORT}/"
            )

    # =========================================================
    # LOCAL URL
    # =========================================================

    def _build_local_url(
        self,
        mp3_path,
    ):

        filename = quote(
            Path(
                mp3_path
            ).name
        )

        return (
            f"http://{HTTP_HOST}:"
            f"{HTTP_PORT}/"
            f"{filename}"
        )

    # =========================================================
    # TRACK REGISTRATION
    # =========================================================

    def _register_track(
        self,
        mp3_path,
        duration,
    ):

        filename = (
            Path(
                mp3_path
            ).name
        )

        with self.lock:

            self.track_info[
                filename
            ] = {
                "path": Path(
                    mp3_path
                ),

                "duration": int(
                    duration or 0
                ),
            }

    # =========================================================
    # FILE REQUEST
    # =========================================================

    def _file_requested(
        self,
        filename,
    ):

        with self.lock:

            info = (
                self.track_info.get(
                    filename
                )
            )

            if not info:
                return

            if (
                filename
                in
                self.cleanup_started
            ):
                return

            self.cleanup_started.add(
                filename
            )

        threading.Thread(
            target=(
                self._cleanup_after_playback
            ),
            args=(
                filename,
                info["path"],
                info["duration"],
            ),
            daemon=True,
            name=(
                "YouTubeCleanup-"
                f"{filename}"
            ),
        ).start()

    # =========================================================
    # AUTOMATIC CLEANUP
    # =========================================================

    def _cleanup_after_playback(
        self,
        filename,
        path,
        duration,
    ):

        if duration > 0:

            wait_seconds = (
                duration + 60
            )

        else:

            wait_seconds = 3600

        print(
            "YOUTUBE CLEANUP: "
            f"{filename} scheduled "
            f"in {wait_seconds}s."
        )

        time.sleep(
            wait_seconds
        )

        for attempt in range(
            1,
            721,
        ):

            try:

                if not path.exists():
                    break

                path.unlink()

                print(
                    "YOUTUBE CLEANUP: "
                    f"Deleted {path}"
                )

                break

            except PermissionError:

                if attempt == 1:

                    print(
                        "YOUTUBE CLEANUP: "
                        "File still in use; "
                        "retrying..."
                    )

                time.sleep(
                    5
                )

            except OSError:

                time.sleep(
                    5
                )

        with self.lock:

            self.track_info.pop(
                filename,
                None,
            )

            self.cleanup_started.discard(
                filename
            )

    # =========================================================
    # STARTUP CLEANUP
    # =========================================================

    def _purge_old_temp_files(
        self,
    ):

        for path in TEMP_DIR.glob(
            "*.mp3"
        ):

            try:

                path.unlink()

            except OSError:

                pass


# =============================================================
# SEARCH-ONLY TEST
# =============================================================

if __name__ == "__main__":

    provider = (
        YouTubeOwnedProvider()
    )

    print()
    print(
        "========================================"
    )

    print(
        "YT-DLP SEARCH TEST"
    )

    print(
        "========================================"
    )

    while True:

        try:

            query = input(
                "Search "
                "(blank to stop): "
            ).strip()

        except (
            KeyboardInterrupt,
            EOFError,
        ):

            print()
            break

        if not query:
            break

        try:

            provider.search_candidates(
                query,
                limit=5,
            )

        except Exception as error:

            print(
                f"ERROR: {error}"
            )
